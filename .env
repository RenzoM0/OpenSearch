# OpenSearch admin wachtwoord
OPENSEARCH_INITIAL_ADMIN_PASSWORD=Patat123!

# OpenSearch connectie
OS_HOST=https://localhost:9200
OS_USER=admin
OS_PASS=Patat123!
OS_VERIFY_SSL=false

# Data-instellingen
# Let op: .env staat BUITEN de Windturbine-map.
# Zet het pad RELATIEF t.o.v. de map van index_csvs.py (handig voor portabiliteit).
DATA_DIR=.
CSV_PATTERN=Location{n}.csv
INDEX_PREFIX=wind-turbine-location

# Bulk & retry
BULK_CHUNK_SIZE=4000
REQUEST_TIMEOUT=120
MAX_RETRIES=3

# Schone run? (verwijder bestaande indices)
DROP_EXISTING=false
