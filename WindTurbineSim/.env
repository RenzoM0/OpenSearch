# --- App environment ---
APP_ENV=development

# --- OpenSearch connection ---
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_SCHEME=https

# If you don't use auth, leave these empty
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=Patat123!

# Default index for turbine data
OPENSEARCH_INDEX=windturbine

# --- Streaming defaults ---
STREAM_DATA_INTERVAL_SECONDS=5
STREAM_HEARTBEAT_INTERVAL_SECONDS=2
LOSS_CONTACT_DURATION_SECONDS=60
FDI_MESSAGES_TO_AFFECT=50
CMD_ACTUATOR_DURATION_SECONDS=60

# Replay the CSV (with live timestamps)
STREAM_MODE=REPLAY_DATASET

# or, to generate synthetic data
## STREAM_MODE=SYNTHETIC
